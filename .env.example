# Скопируйте в .env (он в .gitignore) и заполните при желании.
# Без ключа ИИ работает на эвристиках — демо не ломается.

# Пароль всех демо-учёток (координаторы coord и coord2, сотрудники — по логину из выгрузки).
# Смените значение и перезапустите сервер — новый пароль получат все учётные записи.
DEMO_PASSWORD=1234

# Ссылка на инцидент в ITSM, {id} заменяется номером. Без неё в карточке кнопка «скопировать номер».
# ITSM_URL=https://itsm.example.ru/incident/{id}

# База SQLite и рабочая копия выгрузки ITSM (по умолчанию в data/)
# DB_FILE=data/radar.db
# INCIDENTS_FILE=data/incidents.json

# Ключ Claude API. Можно не задавать, если выполнен `ant auth login`.
ANTHROPIC_API_KEY=

# Модель для ИИ-разбора (по умолчанию claude-opus-5-5)
# AI_MODEL=claude-opus-5-5

# Принудительно выключить LLM и работать только на эвристиках: 1
# AI_DISABLE_LLM=

# Порт (по умолчанию 5190)
# PORT=5190

# Скопируйте в .env (он в .gitignore) и заполните при желании.
# Без ключа ИИ работает на эвристиках — демо не ломается.

# Ключ Claude API. Можно не задавать, если выполнен `ant auth login`.
ANTHROPIC_API_KEY=

# Модель для ИИ-разбора (по умолчанию claude-opus-5-5)
# AI_MODEL=claude-opus-5-5

# Принудительно выключить LLM и работать только на эвристиках: 1
# AI_DISABLE_LLM=

# Порт (по умолчанию 5190)
# PORT=5190

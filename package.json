{
  "name": "mts-incidents",
  "version": "0.1.0",
  "private": true,
  "description": "Радар инцидентов — дашборд координатора IT-инцидентов (кейс МТС, Cyber Garden)",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
